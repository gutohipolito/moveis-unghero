datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Company {
  id       String   @id @default(uuid())
  nome     String
  cnpj     String   @unique
  telefone String
  email    String
  users    User[]
  clients  Client[]
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  // Custom Business Fields
  company_id    String
  company       Company    @relation(fields: [company_id], references: [id])
  senha         String?    // Opcional pois o login social/Better Auth usa senha na tabela Account
  cargo         Role       // ADMIN, COMERCIAL, PROJETISTA, PRODUCAO, FINANCEIRO
  
  // Relations
  sessions      Session[]
  accounts      Account[]
  timeline      Timeline[]
}

enum Role {
  ADMIN
  COMERCIAL
  PROJETISTA
  PRODUCAO
  FINANCEIRO
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Client {
  id          String    @id @default(uuid())
  company_id  String
  company     Company   @relation(fields: [company_id], references: [id])
  nome        String
  telefone    String
  email       String
  cidade      String
  origem      Origin    // SITE, INSTAGRAM, INDICACAO, GOOGLE, WHATSAPP, FACEBOOK
  status      String
  observacoes String?
  projects    Project[]
}

enum Origin {
  SITE
  INSTAGRAM
  INDICACAO
  GOOGLE
  WHATSAPP
  FACEBOOK
}

model Project {
  id             String        @id @default(uuid())
  client_id      String
  client         Client        @relation(fields: [client_id], references: [id])
  valor_previsto Decimal       @db.Decimal(12, 2)
  status_geral   ProjectStatus // LEAD, ORCAMENTO, NEGOCIACAO, CONFERENCIA_TECNICA, APROVADO, PRODUCAO, INSTALACAO, FINALIZADO
  environments   Environment[]
  quotes         Quote[]
  files          File[]
  tasks          Task[]
  timeline       Timeline[]
}

enum ProjectStatus {
  LEAD
  ORCAMENTO
  NEGOCIACAO
  CONFERENCIA_TECNICA
  APROVADO
  PRODUCAO
  INSTALACAO
  FINALIZADO
}

model Environment {
  id         String            @id @default(uuid())
  project_id String
  project    Project           @relation(fields: [project_id], references: [id])
  nome       String            // Ex: "Cozinha Americana", "Closet Master"
  tipo       EnvironmentType   // COZINHA, CLOSET, DORMITORIO, BANHEIRO, OUTROS
  status     EnvironmentStatus // AGUARDANDO_MEDICAO, EM_DETALHAMENTO, PRONTO_PRODUCAO, EM_CORTE, MONTAGEM_FABRICA, PRONTO_ENTREGA, EM_INSTALACAO, FINALIZADO
}

enum EnvironmentType {
  COZINHA
  CLOSET
  DORMITORIO
  BANHEIRO
  OUTROS
}

enum EnvironmentStatus {
  AGUARDANDO_MEDICAO
  EM_DETALHAMENTO
  PRONTO_PRODUCAO
  EM_CORTE
  MONTAGEM_FABRICA
  PRONTO_ENTREGA
  EM_INSTALACAO
  FINALIZADO
}

model Quote {
  id          String      @id @default(uuid())
  project_id  String
  project     Project     @relation(fields: [project_id], references: [id])
  versao      Int         @default(1)
  subtotal    Decimal     @db.Decimal(12, 2)
  desconto    Decimal     @db.Decimal(12, 2)
  valor_final Decimal     @db.Decimal(12, 2)
  validade    DateTime
  observacoes String?
  items       QuoteItem[]
}

model QuoteItem {
  id            String   @id @default(uuid())
  quote_id      String
  quote         Quote    @relation(fields: [quote_id], references: [id])
  descricao     String
  quantidade    Int
  tipo_custo    ItemType // MOVEIS_MDF, FERRAGENS_ESPECIAIS, MAO_DE_OBRA, OUTROS
  valor_unitario Decimal  @db.Decimal(12, 2)
  valor_total   Decimal  @db.Decimal(12, 2)
}

enum ItemType {
  MOVEIS_MDF
  FERRAGENS_ESPECIAIS
  MAO_DE_OBRA
  OUTROS
}

model File {
  id                String   @id @default(uuid())
  project_id        String
  project           Project  @relation(fields: [project_id], references: [id])
  tipo              FileType // MEDICAO, RENDER, CONTRATO, FOTO, PROJETO_TECNICO
  url               String
  versao            Int      @default(1)
  aprovado_producao Boolean  @default(false)
}

enum FileType {
  MEDICAO
  RENDER
  CONTRATO
  FOTO
  PROJETO_TECNICO
}

model Task {
  id          String   @id @default(uuid())
  project_id  String
  project     Project  @relation(fields: [project_id], references: [id])
  responsavel String
  data        DateTime
  status      String
}

model Timeline {
  id                String   @id @default(uuid())
  project_id        String
  project           Project  @relation(fields: [project_id], references: [id])
  user_id           String
  user              User     @relation(fields: [user_id], references: [id])
  acao              String
  data              DateTime @default(now())
  interno_sotamente Boolean  @default(true)
}
