datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Company {
  id       String   @id @default(uuid())
  nome     String
  cnpj     String   @unique
  telefone String
  email    String
  permissions Json?  // Permissões de acesso por cargo (mapa cargo -> módulos permitidos)
  users    User[]
  supplyTickets SupplyTicket[]
  quoteItemPresets QuoteItemPreset[]
  quoteDetailPresets QuoteDetailPreset[]
  clients  Client[]
  catalogGroups CatalogGroup[]
  professionalPartners ProfessionalPartner[]
  suppliers      Supplier[]
  inventoryItems InventoryItem[]
  showcaseProducts ShowcaseProduct[]
  productCatalogs  ProductCatalog[]
  expenses       Expense[]
  suggestions    Suggestion[]
  contractTemplates ContractTemplate[]
  contracts         Contract[]
  paymentReceipts   PaymentReceipt[]
  accessCredentials AccessCredential[]
}

/** Cofre de acessos da empresa (sites, e-mails, hospedagem, etc.). */
model AccessCredential {
  id         String   @id @default(uuid())
  company_id String
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  titulo     String
  categoria  String   @default("SITE") // SITE | EMAIL | HOSPEDAGEM | REDE_SOCIAL | BANCO | SOFTWARE | OUTRO
  url        String?
  usuario    String?
  senha_enc  String?  // AES-256-GCM (nunca em texto puro)
  notas      String?
  favorito   Boolean  @default(false)
  ordem      Int      @default(0)
  created_by String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([company_id])
  @@index([company_id, categoria])
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  // Custom Business Fields
  company_id    String
  company       Company    @relation(fields: [company_id], references: [id])
  senha         String?    // Opcional pois o login social/Better Auth usa senha na tabela Account
  cargo         Role       // ADMIN, COMERCIAL, PROJETISTA, PRODUCAO, FINANCEIRO — acesso ao painel
  areaAtuacao   String?    // legado (texto livre); preferir `funcoes`
  funcoes       String[]   @default([]) // funções operacionais (MARCENEIRO, MONTADOR, …) — pode ter várias
  tem_acesso    Boolean    @default(true) // false = equipe operacional sem login no painel
  preferences   Json?      // Preferências de UI por usuário (ex.: itens por página nas listas)
  
  // Relations
  sessions      Session[]
  accounts      Account[]
  timeline      Timeline[]
  ambientes_sob_responsabilidade Environment[] @relation("UserResponsavel")
  ambientes_como_ajudante      Environment[] @relation("UserAjudante")
  timecards     TimeCard[]
  projetos_sob_responsabilidade  Project[]     @relation("ProjectResponsavel")
  projetos_conf_tecnica_resp1    Project[]     @relation("ProjectConfTecnicaResp1")
  projetos_conf_tecnica_resp2    Project[]     @relation("ProjectConfTecnicaResp2")
  operatorNotes     OperatorNote[]
  operatorReminders OperatorReminder[]
  clientAttachments ClientAttachment[] @relation("ClientAttachmentUploader")
  environmentAttachments EnvironmentAttachment[] @relation("EnvironmentAttachmentUploader")
  productCatalogsUploaded ProductCatalog[] @relation("ProductCatalogUploader")
  pushSubscriptions PushSubscription[]
  supplyTicketsRequested SupplyTicket[] @relation("SupplyTicketRequester")
  supplyTicketsResolved  SupplyTicket[] @relation("SupplyTicketResolver")
  suggestionsCreated  Suggestion[] @relation("SuggestionAuthor")
  suggestionsResolved Suggestion[] @relation("SuggestionResolver")
  quoteItemsApproved  QuoteItem[] @relation("QuoteItemApprover")
  quoteApprovals      QuoteApproval[] @relation("QuoteApprovalApprover")
  quoteItemPriceHistory QuoteItemPriceHistory[] @relation("QuoteItemPriceHistoryAuthor")
}

enum Role {
  ADMIN
  COMERCIAL
  PROJETISTA
  PRODUCAO
  FINANCEIRO
  VIEWER
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Client {
  id           String     @id @default(uuid())
  company_id   String
  company      Company    @relation(fields: [company_id], references: [id])
  nome         String
  telefone     String
  telefone_digits String?
  email        String
  cidade       String
  origem       Origin     // SITE, INSTAGRAM, INDICACAO, GOOGLE, WHATSAPP, FACEBOOK
  status       String
  observacoes  String?
  projects     Project[]
  tipo_pessoa  TipoPessoa @default(PF)
  cpf          String?

  // Campos cadastrais de endereço e imóvel
  cnpj         String?
  cep          String?
  endereco     String?
  numero       String?
  bairro       String?
  uf           String?
  tipo_imovel  String?   // Casa, Apartamento, Comercial, etc.
  obs_imovel   String?   // Observações do imóvel/obra
  obs_entrega  String?   // Restrições/observações de entrega
  lgpd_aceite       Boolean   @default(false)
  lgpd_aceite_em    DateTime?
  marketing_aceite  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @default(now()) @updatedAt
  attachments  ClientAttachment[]
  contracts    Contract[]
  paymentReceipts PaymentReceipt[]

  @@index([company_id, telefone_digits])
  @@index([company_id, updatedAt])
}

enum Origin {
  SITE
  INSTAGRAM
  INDICACAO
  GOOGLE
  WHATSAPP
  FACEBOOK
  FORMULARIO
}

enum TipoPessoa {
  PF
  PJ
}

enum PartnerType {
  PROJETISTA
  ARQUITETO
  DECORADOR
  ENGENHEIRO
  DESIGNER_INTERIORES
  OUTROS
}

model ProfessionalPartner {
  id                     String      @id @default(uuid())
  company_id             String
  company                Company     @relation(fields: [company_id], references: [id])
  nome                   String
  tipo                   PartnerType
  email                  String?
  telefone               String?
  cidade                 String?
  escritorio             String?
  registro_profissional  String?
  origem                 String?
  observacoes            String?
  ativo                  Boolean     @default(true)
  fotoUrl                String?
  imagens                String?
  portfolioUrl           String?
  projects               Project[]   @relation("PartnerProjects")
  quotes                 Quote[]     @relation("PartnerQuotes")
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
}

model Project {
  id             String        @id @default(uuid())
  client_id      String
  client         Client        @relation(fields: [client_id], references: [id])
  valor_previsto Decimal       @db.Decimal(12, 2)
  status_geral   ProjectStatus
  environments   Environment[]
  quotes         Quote[]
  files          File[]
  tasks          Task[]
  timeline       Timeline[]
  installments   Installment[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  ultimo_contato_em     DateTime?
  motivo_perda          String?
  
  // Controle Operacional do Projeto
  data_entrega_prevista DateTime?
  responsavel_id        String?
  responsavel           User?         @relation("ProjectResponsavel", fields: [responsavel_id], references: [id])
  // Responsáveis da conferência técnica no cliente (até 2), atribuídos em Aprovados
  conf_tecnica_resp1_id String?
  conf_tecnica_resp1    User?         @relation("ProjectConfTecnicaResp1", fields: [conf_tecnica_resp1_id], references: [id])
  conf_tecnica_resp2_id String?
  conf_tecnica_resp2    User?         @relation("ProjectConfTecnicaResp2", fields: [conf_tecnica_resp2_id], references: [id])
  partner_id            String?
  partner               ProfessionalPartner? @relation("PartnerProjects", fields: [partner_id], references: [id])
  observacoes           String?
  slaState              ProjectSlaState?
  briefing              LeadBriefing?
  attachments           ClientAttachment[] @relation("ProjectAttachments")
  supplyTickets         SupplyTicket[]
  expenses              Expense[]
  contracts             Contract[]
  paymentReceipts       PaymentReceipt[]

  @@index([client_id])
  @@index([status_geral])
  @@index([partner_id])
  @@index([responsavel_id])
  @@index([conf_tecnica_resp1_id])
  @@index([conf_tecnica_resp2_id])
}

enum ProjectStatus {
  LEAD
  ORCAMENTO
  NEGOCIACAO
  CONFERENCIA_TECNICA
  APROVADO
  PRODUCAO
  INSTALACAO
  FINALIZADO
  PERDIDO
}

model Environment {
  id             String            @id @default(uuid())
  project_id     String
  project        Project           @relation(fields: [project_id], references: [id])
  nome           String            // Ex: "Cozinha Americana", "Closet Master"
  tipo           EnvironmentType   // COZINHA, CLOSET, DORMITORIO, BANHEIRO, OUTROS
  status         EnvironmentStatus // AGUARDANDO_MEDICAO, EM_DETALHAMENTO, PRONTO_PRODUCAO, EM_CORTE, MONTAGEM_FABRICA, PRONTO_ENTREGA, EM_INSTALACAO, FINALIZADO
  quote_item_id  String?           @unique
  quoteItem      QuoteItem?        @relation(fields: [quote_item_id], references: [id], onDelete: SetNull)
  
  // Equipe na fábrica
  responsavel_id String?
  responsavel    User?             @relation("UserResponsavel", fields: [responsavel_id], references: [id])
  ajudante_id    String?
  ajudante       User?             @relation("UserAjudante", fields: [ajudante_id], references: [id])

  // Ficha técnica de produção (por cômodo)
  materiais            String?  @db.Text
  ferragens            String?  @db.Text
  acabamentos          String?  @db.Text
  medidas_observacoes  String?  @db.Text
  observacoes_fabrica  String?  @db.Text
  capa_attachment_id   String?

  attachments EnvironmentAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([project_id])
  @@index([responsavel_id])
  @@index([ajudante_id])
  @@index([updatedAt])
}

enum EnvironmentAttachmentCategory {
  PROJETO_ARQUITETO
  PROJETO_FABRICA
  RENDER
  REFERENCIA
  MEDICAO
  FOTO
}

model EnvironmentAttachment {
  id             String                         @id @default(uuid())
  environment_id String
  environment    Environment                    @relation(fields: [environment_id], references: [id], onDelete: Cascade)
  company_id     String
  nome           String
  mime_type      String
  url            String
  size_bytes     Int?
  categoria      EnvironmentAttachmentCategory  @default(FOTO)
  uploaded_by_id String?
  uploaded_by    User?                          @relation("EnvironmentAttachmentUploader", fields: [uploaded_by_id], references: [id], onDelete: SetNull)
  createdAt      DateTime                       @default(now())

  @@index([environment_id])
  @@index([company_id])
}

enum EnvironmentType {
  COZINHA
  CLOSET
  DORMITORIO
  BANHEIRO
  OUTROS
}

enum EnvironmentStatus {
  AGUARDANDO_MEDICAO
  EM_DETALHAMENTO
  PRONTO_PRODUCAO
  EM_CORTE
  MONTAGEM_FABRICA
  PRONTO_ENTREGA
  EM_INSTALACAO
  FINALIZADO
}

model Quote {
  id          String      @id @default(uuid())
  project_id  String
  project     Project     @relation(fields: [project_id], references: [id])
  versao      Int         @default(1)
  template_tipo String    @default("BASICO")
  codigo      String?
  subtotal    Decimal     @db.Decimal(12, 2)
  desconto    Decimal     @db.Decimal(12, 2)
  valor_final Decimal     @db.Decimal(12, 2)
  validade    DateTime
  observacoes String?
  pdf_share_url String?
  pdf_share_code String? @unique
  pdf_shared_at DateTime?
  pdf_view_count Int @default(0)
  pdf_first_viewed_at DateTime?
  pdf_last_viewed_at DateTime?
  pdf_last_device String?
  pdf_last_os String?
  aprovado_em   DateTime?
  partner_id  String?
  partner     ProfessionalPartner? @relation("PartnerQuotes", fields: [partner_id], references: [id], onDelete: SetNull)
  items       QuoteItem[]
  approvals   QuoteApproval[]
  views       QuoteView[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  @@unique([codigo])
  @@index([project_id])
  @@index([partner_id])
  @@index([template_tipo])
  @@index([createdAt])
  @@index([updatedAt])
}

model QuoteView {
  id         String   @id @default(uuid())
  quote_id   String
  quote      Quote    @relation(fields: [quote_id], references: [id], onDelete: Cascade)
  viewed_at  DateTime @default(now())
  user_agent String?
  is_preview Boolean  @default(false)
  device     String?
  os         String?

  @@index([quote_id, viewed_at])
}

enum QuoteItemStatus {
  PENDENTE
  APROVADO
  RECUSADO
}

model QuoteItem {
  id                   String           @id @default(uuid())
  quote_id             String
  quote                Quote            @relation(fields: [quote_id], references: [id])
  descricao            String
  quantidade           Int
  tipo_custo           ItemType // MOVEIS_MDF, FERRAGENS_ESPECIAIS, MAO_DE_OBRA, OUTROS
  valor_unitario       Decimal          @db.Decimal(12, 2)
  valor_total          Decimal          @db.Decimal(12, 2)
  subitens             Json?
  showcase_product_id  String?
  showcaseProduct      ShowcaseProduct? @relation(fields: [showcase_product_id], references: [id], onDelete: SetNull)
  status               QuoteItemStatus  @default(PENDENTE)
  aprovado_em          DateTime?
  aprovado_por_id      String?
  aprovado_por         User?            @relation("QuoteItemApprover", fields: [aprovado_por_id], references: [id], onDelete: SetNull)
  approval_id          String?
  approval             QuoteApproval?   @relation(fields: [approval_id], references: [id], onDelete: SetNull)
  environment          Environment?
  priceHistory         QuoteItemPriceHistory[]

  @@index([showcase_product_id])
  @@index([quote_id, status])
  @@index([approval_id])
}

model QuoteApproval {
  id               String      @id @default(uuid())
  quote_id         String
  quote            Quote       @relation(fields: [quote_id], references: [id], onDelete: Cascade)
  subtotal         Decimal     @db.Decimal(12, 2)
  desconto         Decimal     @db.Decimal(12, 2)
  valor_aprovado   Decimal     @db.Decimal(12, 2)
  aprovado_em      DateTime    @default(now())
  aprovado_por_id  String?
  aprovado_por     User?       @relation("QuoteApprovalApprover", fields: [aprovado_por_id], references: [id], onDelete: SetNull)
  observacoes      String?
  items            QuoteItem[]
  createdAt        DateTime    @default(now())

  @@index([quote_id])
  @@index([aprovado_em])
}

model QuoteItemPriceHistory {
  id                String    @id @default(uuid())
  quote_item_id     String
  quoteItem         QuoteItem @relation(fields: [quote_item_id], references: [id], onDelete: Cascade)
  valor_unitario_anterior Decimal @db.Decimal(12, 2)
  valor_total_anterior    Decimal @db.Decimal(12, 2)
  valor_unitario_novo     Decimal @db.Decimal(12, 2)
  valor_total_novo        Decimal @db.Decimal(12, 2)
  motivo            String?
  alterado_por_id   String?
  alterado_por      User?     @relation("QuoteItemPriceHistoryAuthor", fields: [alterado_por_id], references: [id], onDelete: SetNull)
  createdAt         DateTime  @default(now())

  @@index([quote_item_id])
}

enum ItemType {
  MOVEIS_MDF
  FERRAGENS_ESPECIAIS
  MAO_DE_OBRA
  OUTROS
}

model File {
  id                String   @id @default(uuid())
  project_id        String
  project           Project  @relation(fields: [project_id], references: [id])
  tipo              FileType // MEDICAO, RENDER, CONTRATO, FOTO, PROJETO_TECNICO
  url               String
  versao            Int      @default(1)
  aprovado_producao Boolean  @default(false)
}

enum FileType {
  MEDICAO
  RENDER
  CONTRATO
  FOTO
  PROJETO_TECNICO
}

enum ClientAttachmentType {
  FOTO
  DOCUMENTO
}

model ClientAttachment {
  id             String               @id @default(uuid())
  client_id      String
  client         Client               @relation(fields: [client_id], references: [id], onDelete: Cascade)
  company_id     String
  project_id     String?
  project        Project?             @relation("ProjectAttachments", fields: [project_id], references: [id], onDelete: SetNull)
  nome           String
  mime_type      String
  url            String
  tipo           ClientAttachmentType @default(FOTO)
  size_bytes     Int?
  createdAt      DateTime             @default(now())
  uploaded_by_id String?
  uploaded_by    User?                @relation("ClientAttachmentUploader", fields: [uploaded_by_id], references: [id])

  @@index([project_id])
}

enum SupplyTicketStatus {
  ABERTO
  EM_ANDAMENTO
  RESOLVIDO
  CANCELADO
}

enum SupplyTicketPriority {
  BAIXA
  MEDIA
  ALTA
}

model QuoteItemPreset {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  descricao   String
  detalhes    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([company_id])
}

model QuoteDetailPreset {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  texto       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([company_id])
}

model SupplyTicket {
  id           String               @id @default(uuid())
  company_id   String
  company      Company              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  titulo       String
  descricao    String
  status       SupplyTicketStatus   @default(ABERTO)
  prioridade   SupplyTicketPriority @default(MEDIA)
  project_id   String?
  project      Project?             @relation(fields: [project_id], references: [id], onDelete: SetNull)
  requested_by String
  requester    User                 @relation("SupplyTicketRequester", fields: [requested_by], references: [id])
  resolved_by  String?
  resolver     User?                @relation("SupplyTicketResolver", fields: [resolved_by], references: [id])
  resolucao    String?
  imagens      String[]             @default([])
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  resolvedAt   DateTime?

  @@index([company_id, status])
}

enum SuggestionStatus {
  ABERTA
  CONCLUIDA
}

model Suggestion {
  id          String            @id @default(uuid())
  company_id  String
  company     Company           @relation(fields: [company_id], references: [id], onDelete: Cascade)
  titulo      String
  descricao   String?
  status      SuggestionStatus  @default(ABERTA)
  created_by  String
  author      User              @relation("SuggestionAuthor", fields: [created_by], references: [id])
  done_by     String?
  resolver    User?             @relation("SuggestionResolver", fields: [done_by], references: [id])
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  doneAt      DateTime?

  @@index([company_id, status])
}

model Task {
  id          String   @id @default(uuid())
  project_id  String
  project     Project  @relation(fields: [project_id], references: [id])
  titulo      String   @default("Tarefa")
  descricao   String?
  responsavel String
  data        DateTime
  status      String   @default("PENDENTE") // PENDENTE, CONCLUIDA
  tipo        TaskType @default(OUTROS)
  updatedAt   DateTime @default(now()) @updatedAt

  @@index([project_id])
  @@index([updatedAt])
}

enum TaskType {
  VISITA_COMERCIAL
  MEDICAO_TECNICA
  ENTREGA_MOVEIS
  INSTALACAO
  OUTROS
}

model Installment {
  id                String            @id @default(uuid())
  project_id        String
  project           Project           @relation(fields: [project_id], references: [id])
  valor             Decimal           @db.Decimal(12, 2)
  data_vencimento   DateTime
  data_pagamento    DateTime?
  status            InstallmentStatus @default(PENDENTE)
  tipo              InstallmentType   @default(PARCELA)
  metodo_pagamento  PaymentMethod     @default(PIX)
  numero_parcela    Int?
  total_parcelas    Int?
  grupo_id          String?
  paymentReceipts   PaymentReceipt[]
  updatedAt         DateTime @default(now()) @updatedAt

  @@index([project_id])
  @@index([status])
  @@index([updatedAt])
}

enum PaymentMethod {
  PIX
  BOLETO
  CARTAO
  DINHEIRO
  TRANSFERENCIA
  CHEQUE
  OUTRO
}

enum InstallmentStatus {
  PENDENTE
  PAGO
  ATRASADO
}

enum InstallmentType {
  ENTRADA
  PARCELA
}

model Timeline {
  id                String   @id @default(uuid())
  project_id        String
  project           Project  @relation(fields: [project_id], references: [id])
  user_id           String
  user              User     @relation(fields: [user_id], references: [id])
  acao              String
  data              DateTime @default(now())
  interno_sotamente Boolean  @default(true)
}

model TimeCard {
  id          String    @id @default(uuid())
  user_id     String
  user        User      @relation(fields: [user_id], references: [id])
  data        DateTime  @default(now())
  entrada     DateTime?
  almoco_in   DateTime?
  almoco_out  DateTime?
  saida       DateTime?
  horas       Decimal?  @db.Decimal(4, 2)
}

// Listas configuráveis por empresa (veículos, categorias de estoque, etc.)
model CatalogGroup {
  id          String        @id @default(uuid())
  company_id  String
  company     Company       @relation(fields: [company_id], references: [id])
  slug        String
  nome        String
  descricao   String?
  usado_em    String?
  items       CatalogItem[]

  @@unique([company_id, slug])
}

model CatalogItem {
  id          String        @id @default(uuid())
  group_id    String
  group       CatalogGroup  @relation(fields: [group_id], references: [id], onDelete: Cascade)
  parent_id   String?
  parent      CatalogItem?  @relation("CatalogSubItems", fields: [parent_id], references: [id], onDelete: Cascade)
  children    CatalogItem[] @relation("CatalogSubItems")
  label       String
  slug        String?
  ordem       Int           @default(0)
  ativo       Boolean       @default(true)
  updatedAt   DateTime      @default(now()) @updatedAt

  @@index([group_id])
  @@index([updatedAt])
}

model OperatorNote {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company_id String
  content    String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([user_id, company_id])
}

model OperatorReminder {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company_id String
  title      String
  due_at     DateTime
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([user_id, company_id, done, due_at])
}

model ProjectSlaState {
  id                   String   @id @default(uuid())
  project_id           String   @unique
  project              Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  current_stage        String
  stage_started_at     DateTime @default(now())
  extension_days       Int      @default(0)
  completed_stages     String[] @default([])
  nota_fiscal_emitida  Boolean  @default(false)
  nota_fiscal_emitida_em DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Supplier {
  id                 String          @id @default(uuid())
  company_id         String
  company            Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  nome               String          // Razão Social
  cnpj               String
  telefone           String          @default("")
  email              String          @default("")
  principal_material String          @default("")
  ativo              Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  inventoryItems     InventoryItem[]
  expenses           Expense[]
  showcaseProducts   ShowcaseProduct[]

  // Novos campos do Cadastro de Fornecedor
  nomeFantasia       String?
  inscricaoEstadual  String?
  categoria          String?
  subcategoria       String?
  site               String?
  instagram          String?
  linkedin           String?
  anoFundacao        Int?
  numFuncionarios    String?         // opcional
  possuiShowroom     Boolean?

  // Contato
  contatoRepresentante String?
  contatoCargo       String?
  contatoWhatsapp    String?
  contatoSegundo     String?
  contatoTelefoneSecundario String?
  contatoCidade      String?
  contatoEstado      String?
  contatoEndereco    String?
  contatoCep         String?

  // Produtos
  produtosFornecidos  String?         @db.Text
  marcasRepresentadas String?         @db.Text
  produtosCatalogoUrl String?
  produtosTabelaPrecosUrl String?
  produtosLinkCatalogoOnline String?
  produtosSobEncomenda Boolean?
  produtosQuantidadeMinima String?
  produtosTempoFabricacao String?

  // Comercial
  comercialCondicoesPagamento String[] @default([]) // Array de strings (Pix, Boleto, etc.)
  comercialDescontoMarceneiros Boolean?
  comercialTabelaDiferenciada Boolean?
  comercialRepresentanteExclusivo Boolean?
  comercialPedidoMinimo String?
  comercialFreteGratisAcima String?
  comercialComissao   String?
  comercialObservacoes String?        @db.Text

  // Logística
  logisticaCidadeEstoque String?
  logisticaPrazoMedioEntrega String?
  logisticaEntregaPropria Boolean?
  logisticaTransportadora Boolean?
  logisticaRetiradaLocal Boolean?
  logisticaEstadosAtendidos String[] @default([])
  logisticaFazEntregasUrgentes Boolean?
  logisticaPossuiRastreamento Boolean?
  logisticaAreaCobertura String?

  // Avaliação Interna (CRM)
  crmStatus          String          @default("NOVO") // NOVO, EM_ANALISE, HOMOLOGADO, INATIVO, BLOQUEADO
  crmNota            Int?            // 1-5 estrelas
  crmQualidade       Int?            // 1-5
  crmPrazo           Int?            // 1-5
  crmAtendimento     Int?            // 1-5
  crmPreco           Int?            // 1-5
  crmPosVenda        Int?            // 1-5
  crmUltimaCompra    DateTime?
  crmValorTotalComprado Decimal?     @db.Decimal(12, 2)
  crmUltimoOrcamento DateTime?
  crmUltimoContato   DateTime?
  crmResponsavelInterno String?
  crmObservacoes     String?         @db.Text
  crmHistorico       Json?           // Array de histórico [{ data: "...", acao: "..." }]
  crmUploads         Json?           // Array de anexos [{ tipo: "...", url: "...", nome: "..." }]
  crmTags            String[]        @default([])

  @@index([company_id])
}

model InventoryItem {
  id          String    @id @default(uuid())
  company_id  String
  company     Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  supplier_id String?
  supplier    Supplier? @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  nome        String
  categoria   String
  quantidade  Int       @default(0)
  minima      Int       @default(0)
  preco_custo Decimal   @db.Decimal(12, 2)
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  showcaseProducts ShowcaseProduct[]

  @@index([company_id])
  @@index([company_id, categoria])
}

model ShowcaseProduct {
  id                String         @id @default(uuid())
  company_id        String
  company           Company        @relation(fields: [company_id], references: [id], onDelete: Cascade)
  inventory_item_id String?
  inventoryItem     InventoryItem? @relation(fields: [inventory_item_id], references: [id], onDelete: SetNull)
  supplier_id       String?
  supplier          Supplier?      @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  nome              String
  descricao         String?        @db.Text
  categoria         String?
  imagem_url        String?
  imagem_mime       String?
  imagens           String[]       @default([])
  preco_exibicao    Decimal?       @db.Decimal(12, 2)
  ordem             Int            @default(0)
  ativo             Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  quoteItems        QuoteItem[]

  @@index([company_id])
  @@index([company_id, ativo])
  @@index([inventory_item_id])
  @@index([company_id, supplier_id])
}

/** Catálogos (PDF/imagens) para apresentar aos clientes no comercial. */
model ProductCatalog {
  id             String   @id @default(uuid())
  company_id     String
  company        Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  titulo         String
  descricao      String?  @db.Text
  marca          String?
  arquivo_url    String
  arquivo_nome   String
  mime_type      String
  size_bytes     Int?
  capa_url       String?
  ordem          Int      @default(0)
  ativo          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  uploaded_by_id String?
  uploaded_by    User?    @relation("ProductCatalogUploader", fields: [uploaded_by_id], references: [id], onDelete: SetNull)

  @@index([company_id])
  @@index([company_id, ativo])
}

model LeadBriefing {
  id                 String   @id @default(uuid())
  project_id         String   @unique
  project            Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  
  ambientes          String   // JSON string contendo os ambientes e condicionais (ex: [{"nome":"Cozinha","opcao":"Cozinha + Ilha"}])
  tipo_imovel        String   // Apartamento, Casa, Comercial
  fase_projeto       String   // Apenas pesquisando, Comparando, Já tenho o projeto, Quero iniciar
  pronto             String   // Sim, Não, Em construção, Breve
  data_chaves        String?  // Mês/Ano
  tem_projeto        String   // Sim, Não, Em desenvolvimento, Preciso de um
  estilo             String   // Minimalista, Moderno, etc.
  faixa_investimento String?
  prazo_inicio       String   // Este mês, Em até 3 meses, etc.
  pinterest_link     String?
  referencia_url     String?  // Arquivo ou referência
  
  // Dados do contato
  origem_lead        String   // Instagram, Google, Indicação, etc.
  
  // Metadados ocultos
  utm_source         String?
  utm_medium         String?
  utm_campaign       String?
  gclid              String?
  fbclid             String?
  ip                 String?
  user_agent         String?
  dispositivo        String?
  os                 String?
  resolution         String?
  idioma             String?
  tempo_preenchimento Int?     // Em segundos
  
  // Lead Score
  score              Int      @default(0)
  roteiro_sugerido   String?  @db.Text
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PushSubscription {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deliveries PushNotificationSent[]

  @@index([user_id])
}

model PushNotificationSent {
  id              String           @id @default(uuid())
  subscription_id String
  subscription    PushSubscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  notification_id String
  sent_at         DateTime         @default(now())

  @@unique([subscription_id, notification_id])
  @@index([subscription_id])
}

// ── Financeiro: Contas a Pagar / Despesas ──────────────────────────────
enum ExpenseNature {
  FIXA
  VARIAVEL
}

enum ExpenseStatus {
  PENDENTE
  PAGO
  CANCELADO
}

enum ExpenseCategory {
  ALUGUEL
  ENERGIA
  AGUA
  INTERNET_TELEFONE
  SALARIOS
  PRO_LABORE
  IMPOSTOS
  MATERIAL
  FERRAGENS
  TERCEIROS
  FRETE_LOGISTICA
  MARKETING
  MANUTENCAO
  EQUIPAMENTOS
  COMBUSTIVEL
  TAXAS_BANCARIAS
  OUTROS
}

model Expense {
  id               String          @id @default(uuid())
  company_id       String
  company          Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  descricao        String
  categoria        ExpenseCategory @default(OUTROS)
  natureza         ExpenseNature   @default(VARIAVEL)
  valor            Decimal         @db.Decimal(12, 2)
  data_vencimento  DateTime
  data_pagamento   DateTime?
  status           ExpenseStatus   @default(PENDENTE)
  metodo_pagamento PaymentMethod?
  supplier_id      String?
  supplier         Supplier?       @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  project_id       String?
  project          Project?        @relation(fields: [project_id], references: [id], onDelete: SetNull)
  fornecedor_nome  String?
  observacoes      String?
  grupo_id         String?         // agrupa lançamentos recorrentes (mesma série mensal)
  created_by       String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([company_id])
  @@index([company_id, status])
  @@index([company_id, data_vencimento])
}

enum ContractStatus {
  RASCUNHO
  EMITIDO
}

model ContractTemplate {
  id                 String     @id @default(uuid())
  company_id         String
  company            Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  nome               String
  titulo             String     @default("CONTRATO DE PRESTAÇÃO DE SERVIÇO")
  clausula_local     String     @db.Text
  clausula_pagamento String     @db.Text
  clausula_prazo     String     @db.Text
  clausula_extra     String?    @db.Text
  ativo              Boolean    @default(true)
  contracts          Contract[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@index([company_id])
}

model Contract {
  id                 String           @id @default(uuid())
  company_id         String
  company            Company          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  template_id        String?
  template           ContractTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  client_id          String?
  client             Client?          @relation(fields: [client_id], references: [id], onDelete: SetNull)
  project_id         String?
  project            Project?         @relation(fields: [project_id], references: [id], onDelete: SetNull)

  titulo             String
  cliente_nome       String
  cliente_documento  String
  cliente_endereco   String
  servicos           String           @db.Text
  valor              Decimal          @db.Decimal(12, 2)
  entrada_pct        Int              @default(50)
  clausula_local     String           @db.Text
  clausula_pagamento String           @db.Text
  clausula_prazo     String           @db.Text
  clausula_extra     String?          @db.Text
  data_entrega       DateTime?
  data_contrato      DateTime
  cidade_emissao     String           @default("Farroupilha")
  status             ContractStatus   @default(RASCUNHO)
  observacoes        String?
  share_code         String?          @unique
  shared_at          DateTime?

  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([company_id])
  @@index([company_id, status])
  @@index([client_id])
  @@index([project_id])
}

enum ReceiptQuitacao {
  TOTAL
  PARCIAL
}

/** Recibo de pagamento emitido pela empresa (PJ) ao cliente. */
model PaymentReceipt {
  id                String          @id @default(uuid())
  company_id        String
  company           Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  client_id         String
  client            Client          @relation(fields: [client_id], references: [id], onDelete: Cascade)
  project_id        String?
  project           Project?        @relation(fields: [project_id], references: [id], onDelete: SetNull)
  installment_id    String?
  installment       Installment?    @relation(fields: [installment_id], references: [id], onDelete: SetNull)

  numero            Int
  valor             Decimal         @db.Decimal(12, 2)
  parcela_numero    Int?
  parcela_total     Int?
  referente         String          @db.Text
  metodo_pagamento  PaymentMethod   @default(PIX)
  data_recebimento  DateTime
  cidade_emissao    String          @default("Farroupilha")
  quitacao          ReceiptQuitacao @default(PARCIAL)

  cliente_nome      String
  cliente_documento String
  cliente_endereco  String?

  emitido_por_id    String?
  emitido_por_nome  String?
  observacoes       String?

  share_code        String?         @unique
  shared_at         DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([company_id, numero])
  @@index([company_id])
  @@index([client_id])
  @@index([project_id])
  @@index([installment_id])
}
