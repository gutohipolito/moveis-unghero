datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Company {
  id       String   @id @default(uuid())
  nome     String
  cnpj     String   @unique
  telefone String
  email    String
  permissions Json?  // Permissões de acesso por cargo (mapa cargo -> módulos permitidos)
  users    User[]
  clients  Client[]
  catalogGroups CatalogGroup[]
  professionalPartners ProfessionalPartner[]
  suppliers      Supplier[]
  inventoryItems InventoryItem[]
}

model User {
  id            String     @id @default(uuid())
  name          String
  email         String     @unique
  emailVerified Boolean    @default(false)
  image         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  
  // Custom Business Fields
  company_id    String
  company       Company    @relation(fields: [company_id], references: [id])
  senha         String?    // Opcional pois o login social/Better Auth usa senha na tabela Account
  cargo         Role       // ADMIN, COMERCIAL, PROJETISTA, PRODUCAO, FINANCEIRO
  areaAtuacao   String?
  preferences   Json?      // Preferências de UI por usuário (ex.: itens por página nas listas)
  
  // Relations
  sessions      Session[]
  accounts      Account[]
  timeline      Timeline[]
  ambientes_sob_responsabilidade Environment[] @relation("UserResponsavel")
  ambientes_como_ajudante      Environment[] @relation("UserAjudante")
  timecards     TimeCard[]
  projetos_sob_responsabilidade  Project[]     @relation("ProjectResponsavel")
  operatorNotes     OperatorNote[]
  operatorReminders OperatorReminder[]
  clientAttachments ClientAttachment[] @relation("ClientAttachmentUploader")
  pushSubscriptions PushSubscription[]
}

enum Role {
  ADMIN
  COMERCIAL
  PROJETISTA
  PRODUCAO
  FINANCEIRO
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?
}

model Client {
  id           String     @id @default(uuid())
  company_id   String
  company      Company    @relation(fields: [company_id], references: [id])
  nome         String
  telefone     String
  telefone_digits String?
  email        String
  cidade       String
  origem       Origin     // SITE, INSTAGRAM, INDICACAO, GOOGLE, WHATSAPP, FACEBOOK
  status       String
  observacoes  String?
  projects     Project[]
  tipo_pessoa  TipoPessoa @default(PF)
  cpf          String?

  // Campos cadastrais de endereço e imóvel
  cnpj         String?
  cep          String?
  endereco     String?
  numero       String?
  bairro       String?
  uf           String?
  tipo_imovel  String?   // Casa, Apartamento, Comercial, etc.
  obs_imovel   String?   // Observações do imóvel/obra
  obs_entrega  String?   // Restrições/observações de entrega
  createdAt    DateTime  @default(now())
  attachments  ClientAttachment[]

  @@index([company_id, telefone_digits])
}

enum Origin {
  SITE
  INSTAGRAM
  INDICACAO
  GOOGLE
  WHATSAPP
  FACEBOOK
  FORMULARIO
}

enum TipoPessoa {
  PF
  PJ
}

enum PartnerType {
  PROJETISTA
  ARQUITETO
  DECORADOR
  ENGENHEIRO
  OUTROS
}

model ProfessionalPartner {
  id          String      @id @default(uuid())
  company_id  String
  company     Company     @relation(fields: [company_id], references: [id])
  nome        String
  tipo        PartnerType
  email       String?
  telefone    String?
  cidade      String?
  escritorio  String?
  observacoes String?
  ativo       Boolean     @default(true)
  fotoUrl     String?
  imagens     String?
  portfolioUrl String?
  projects     Project[]          @relation("PartnerProjects")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Project {
  id             String        @id @default(uuid())
  client_id      String
  client         Client        @relation(fields: [client_id], references: [id])
  valor_previsto Decimal       @db.Decimal(12, 2)
  status_geral   ProjectStatus
  environments   Environment[]
  quotes         Quote[]
  files          File[]
  tasks          Task[]
  timeline       Timeline[]
  installments   Installment[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt
  ultimo_contato_em     DateTime?
  motivo_perda          String?
  
  // Controle Operacional do Projeto
  data_entrega_prevista DateTime?
  responsavel_id        String?
  responsavel           User?         @relation("ProjectResponsavel", fields: [responsavel_id], references: [id])
  partner_id            String?
  partner               ProfessionalPartner? @relation("PartnerProjects", fields: [partner_id], references: [id])
  observacoes           String?
  slaState              ProjectSlaState?
  briefing              LeadBriefing?
  attachments           ClientAttachment[] @relation("ProjectAttachments")
}

enum ProjectStatus {
  LEAD
  ORCAMENTO
  NEGOCIACAO
  CONFERENCIA_TECNICA
  APROVADO
  PRODUCAO
  INSTALACAO
  FINALIZADO
  PERDIDO
}

model Environment {
  id             String            @id @default(uuid())
  project_id     String
  project        Project           @relation(fields: [project_id], references: [id])
  nome           String            // Ex: "Cozinha Americana", "Closet Master"
  tipo           EnvironmentType   // COZINHA, CLOSET, DORMITORIO, BANHEIRO, OUTROS
  status         EnvironmentStatus // AGUARDANDO_MEDICAO, EM_DETALHAMENTO, PRONTO_PRODUCAO, EM_CORTE, MONTAGEM_FABRICA, PRONTO_ENTREGA, EM_INSTALACAO, FINALIZADO
  
  // Equipe na fábrica
  responsavel_id String?
  responsavel    User?             @relation("UserResponsavel", fields: [responsavel_id], references: [id])
  ajudante_id    String?
  ajudante       User?             @relation("UserAjudante", fields: [ajudante_id], references: [id])
}

enum EnvironmentType {
  COZINHA
  CLOSET
  DORMITORIO
  BANHEIRO
  OUTROS
}

enum EnvironmentStatus {
  AGUARDANDO_MEDICAO
  EM_DETALHAMENTO
  PRONTO_PRODUCAO
  EM_CORTE
  MONTAGEM_FABRICA
  PRONTO_ENTREGA
  EM_INSTALACAO
  FINALIZADO
}

model Quote {
  id          String      @id @default(uuid())
  project_id  String
  project     Project     @relation(fields: [project_id], references: [id])
  versao      Int         @default(1)
  subtotal    Decimal     @db.Decimal(12, 2)
  desconto    Decimal     @db.Decimal(12, 2)
  valor_final Decimal     @db.Decimal(12, 2)
  validade    DateTime
  observacoes String?
  pdf_share_url String?
  pdf_share_code String? @unique
  pdf_shared_at DateTime?
  aprovado_em   DateTime?
  items       QuoteItem[]
}

model QuoteItem {
  id            String   @id @default(uuid())
  quote_id      String
  quote         Quote    @relation(fields: [quote_id], references: [id])
  descricao     String
  quantidade    Int
  tipo_custo    ItemType // MOVEIS_MDF, FERRAGENS_ESPECIAIS, MAO_DE_OBRA, OUTROS
  valor_unitario Decimal  @db.Decimal(12, 2)
  valor_total   Decimal  @db.Decimal(12, 2)
  subitens      Json?
}

enum ItemType {
  MOVEIS_MDF
  FERRAGENS_ESPECIAIS
  MAO_DE_OBRA
  OUTROS
}

model File {
  id                String   @id @default(uuid())
  project_id        String
  project           Project  @relation(fields: [project_id], references: [id])
  tipo              FileType // MEDICAO, RENDER, CONTRATO, FOTO, PROJETO_TECNICO
  url               String
  versao            Int      @default(1)
  aprovado_producao Boolean  @default(false)
}

enum FileType {
  MEDICAO
  RENDER
  CONTRATO
  FOTO
  PROJETO_TECNICO
}

enum ClientAttachmentType {
  FOTO
  DOCUMENTO
}

model ClientAttachment {
  id             String               @id @default(uuid())
  client_id      String
  client         Client               @relation(fields: [client_id], references: [id], onDelete: Cascade)
  company_id     String
  project_id     String?
  project        Project?             @relation("ProjectAttachments", fields: [project_id], references: [id], onDelete: SetNull)
  nome           String
  mime_type      String
  url            String
  tipo           ClientAttachmentType @default(FOTO)
  size_bytes     Int?
  createdAt      DateTime             @default(now())
  uploaded_by_id String?
  uploaded_by    User?                @relation("ClientAttachmentUploader", fields: [uploaded_by_id], references: [id])

  @@index([project_id])
}

model Task {
  id          String   @id @default(uuid())
  project_id  String
  project     Project  @relation(fields: [project_id], references: [id])
  titulo      String   @default("Tarefa")
  descricao   String?
  responsavel String
  data        DateTime
  status      String   @default("PENDENTE") // PENDENTE, CONCLUIDA
  tipo        TaskType @default(OUTROS)
}

enum TaskType {
  VISITA_COMERCIAL
  MEDICAO_TECNICA
  ENTREGA_MOVEIS
  INSTALACAO
  OUTROS
}

model Installment {
  id                String            @id @default(uuid())
  project_id        String
  project           Project           @relation(fields: [project_id], references: [id])
  valor             Decimal           @db.Decimal(12, 2)
  data_vencimento   DateTime
  data_pagamento    DateTime?
  status            InstallmentStatus @default(PENDENTE)
  tipo              InstallmentType   @default(PARCELA)
  metodo_pagamento  PaymentMethod     @default(PIX)
  numero_parcela    Int?
  total_parcelas    Int?
  grupo_id          String?
}

enum PaymentMethod {
  PIX
  BOLETO
  CARTAO
  DINHEIRO
  TRANSFERENCIA
  CHEQUE
  OUTRO
}

enum InstallmentStatus {
  PENDENTE
  PAGO
  ATRASADO
}

enum InstallmentType {
  ENTRADA
  PARCELA
}

model Timeline {
  id                String   @id @default(uuid())
  project_id        String
  project           Project  @relation(fields: [project_id], references: [id])
  user_id           String
  user              User     @relation(fields: [user_id], references: [id])
  acao              String
  data              DateTime @default(now())
  interno_sotamente Boolean  @default(true)
}

model TimeCard {
  id          String    @id @default(uuid())
  user_id     String
  user        User      @relation(fields: [user_id], references: [id])
  data        DateTime  @default(now())
  entrada     DateTime?
  almoco_in   DateTime?
  almoco_out  DateTime?
  saida       DateTime?
  horas       Decimal?  @db.Decimal(4, 2)
}

// Listas configuráveis por empresa (veículos, categorias de estoque, etc.)
model CatalogGroup {
  id          String        @id @default(uuid())
  company_id  String
  company     Company       @relation(fields: [company_id], references: [id])
  slug        String
  nome        String
  descricao   String?
  usado_em    String?
  items       CatalogItem[]

  @@unique([company_id, slug])
}

model CatalogItem {
  id          String        @id @default(uuid())
  group_id    String
  group       CatalogGroup  @relation(fields: [group_id], references: [id], onDelete: Cascade)
  parent_id   String?
  parent      CatalogItem?  @relation("CatalogSubItems", fields: [parent_id], references: [id], onDelete: Cascade)
  children    CatalogItem[] @relation("CatalogSubItems")
  label       String
  slug        String?
  ordem       Int           @default(0)
  ativo       Boolean       @default(true)
}

model OperatorNote {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company_id String
  content    String
  pinned     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([user_id, company_id])
}

model OperatorReminder {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company_id String
  title      String
  due_at     DateTime
  done       Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([user_id, company_id, done, due_at])
}

model ProjectSlaState {
  id                   String   @id @default(uuid())
  project_id           String   @unique
  project              Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  current_stage        String
  stage_started_at     DateTime @default(now())
  extension_days       Int      @default(0)
  completed_stages     String[] @default([])
  nota_fiscal_emitida  Boolean  @default(false)
  nota_fiscal_emitida_em DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model Supplier {
  id                 String          @id @default(uuid())
  company_id         String
  company            Company         @relation(fields: [company_id], references: [id], onDelete: Cascade)
  nome               String
  cnpj               String
  telefone           String          @default("")
  email              String          @default("")
  principal_material String          @default("")
  ativo              Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  inventoryItems     InventoryItem[]

  @@index([company_id])
}

model InventoryItem {
  id          String    @id @default(uuid())
  company_id  String
  company     Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  supplier_id String?
  supplier    Supplier? @relation(fields: [supplier_id], references: [id], onDelete: SetNull)
  nome        String
  categoria   String
  quantidade  Int       @default(0)
  minima      Int       @default(0)
  preco_custo Decimal   @db.Decimal(12, 2)
  ativo       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([company_id])
  @@index([company_id, categoria])
}

model LeadBriefing {
  id                 String   @id @default(uuid())
  project_id         String   @unique
  project            Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)
  
  ambientes          String   // JSON string contendo os ambientes e condicionais (ex: [{"nome":"Cozinha","opcao":"Cozinha + Ilha"}])
  tipo_imovel        String   // Apartamento, Casa, Comercial
  fase_projeto       String   // Apenas pesquisando, Comparando, Já tenho o projeto, Quero iniciar
  pronto             String   // Sim, Não, Em construção, Breve
  data_chaves        String?  // Mês/Ano
  tem_projeto        String   // Sim, Não, Em desenvolvimento, Preciso de um
  estilo             String   // Minimalista, Moderno, etc.
  faixa_investimento String?
  prazo_inicio       String   // Este mês, Em até 3 meses, etc.
  pinterest_link     String?
  referencia_url     String?  // Arquivo ou referência
  
  // Dados do contato
  origem_lead        String   // Instagram, Google, Indicação, etc.
  
  // Metadados ocultos
  utm_source         String?
  utm_medium         String?
  utm_campaign       String?
  gclid              String?
  fbclid             String?
  ip                 String?
  user_agent         String?
  dispositivo        String?
  os                 String?
  resolution         String?
  idioma             String?
  tempo_preenchimento Int?     // Em segundos
  
  // Lead Score
  score              Int      @default(0)
  roteiro_sugerido   String?  @db.Text
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model PushSubscription {
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  endpoint   String   @unique
  p256dh     String
  auth       String
  user_agent String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deliveries PushNotificationSent[]

  @@index([user_id])
}

model PushNotificationSent {
  id              String           @id @default(uuid())
  subscription_id String
  subscription    PushSubscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade)
  notification_id String
  sent_at         DateTime         @default(now())

  @@unique([subscription_id, notification_id])
  @@index([subscription_id])
}
