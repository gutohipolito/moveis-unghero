# Neon PostgreSQL (use a connection string com pooling)
DATABASE_URL="postgresql://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require"

# Better Auth — obrigatório em produção
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_BETTER_AUTH_URL="http://localhost:3000"

# Secret para criar o primeiro admin via /api/create-admin-prod (opcional)
ADMIN_SETUP_SECRET=""

# Google Analytics 4 (service account com acesso de Leitor na propriedade)
GA4_PROPERTY_ID=415410108
GA4_CLIENT_EMAIL=ga4-reader@moveis-unghero-admin.iam.gserviceaccount.com
GA4_PRIVATE_KEY=
# Opção mais simples na Vercel: cole o JSON inteiro da service account aqui
GA4_SERVICE_ACCOUNT_JSON=
